def check_password(password):
    uppercase = False
    lowercase = False
    digit = False
    special = False

    for ch in password:
        if ch.isupper():
            uppercase = True
        elif ch.islower():
            lowercase = True
        elif ch.isdigit():
            digit = True
        else:
            special = True

    if len(password) >= 8 and uppercase and lowercase and digit and special:
        print("Strong Password")
    else:
        print("Weak Password")


password = input("Enter your password: ")

check_password(password)

