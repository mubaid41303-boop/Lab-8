name = input("Enter student name: ")
roll_no = input("Enter roll number: ")

marks1 = float(input("Enter English marks: "))
marks2 = float(input("Enter Maths marks: "))
marks3 = float(input("Enter Computer marks: "))
marks4 = float(input("Enter Physics marks: "))
marks5 = float(input("Enter Chemistry marks: "))

total = marks1 + marks2 + marks3 + marks4 + marks5
percentage = total / 500 * 100

if marks1 < 40 or marks2 < 40 or marks3 < 40 or marks4 < 40 or marks5 < 40:
    grade = "F"
    result = "Fail"
elif percentage >= 80:
    grade = "A+"
    result = "Pass"
elif percentage >= 70:
    grade = "A"
    result = "Pass"
elif percentage >= 60:
    grade = "B"
    result = "Pass"
elif percentage >= 50:
    grade = "C"
    result = "Pass"
elif percentage >= 40:
    grade = "D"
    result = "Pass"
else:
    grade = "F"
    result = "Fail"

print("\n----- STUDENT MARKSHEET -----")
print("Name:", name)
print("Roll Number:", roll_no)
print("English:", marks1)
print("Maths:", marks2)
print("Computer:", marks3)
print("Physics:", marks4)
print("Chemistry:", marks5)
print("Total Marks:", total, "/ 500")
print("Percentage:", percentage, "%")
print("Grade:", grade)
print("Result:", result)

